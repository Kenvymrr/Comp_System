.data
prompt: .string "Vvedite x: "
.eqv STUDENT_NUM 22

.text
.globl main
main:
    li a7, 4
    la a0, prompt
    ecall

    li a7, 5
    ecall
    mv t0, a0

    li t1, STUDENT_NUM
    beq t0, t1, is_equal
    li a0, 0 
    j print_result

is_equal:
    li a0, 1

print_result:
    li a7, 1
    ecall

    li a7, 10
    ecall