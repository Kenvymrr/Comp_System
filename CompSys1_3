.data
    array:  .space 152

    # "Enter number: "
    str_enter:  .byte 'E','n','t','e','r',' ','n','u','m','b','e','r',':',' ',0
    
    # "Count: "
    str_count:  .byte 'C','o','u','n','t',':',' ',0
    
    # "Array: "
    str_array:  .byte 'A','r','r','a','y',':',' ',0

.text
.globl main

main:
    la   s0, array
    li   s1, 0
    li   s2, 38

loop_input:
    beq  s1, s2, end_input

    la   t2, str_enter
    jal  ra, print_str

    li   a7, 5
    ecall
    mv   t0, a0

    beq  t0, zero, end_input

    sw   t0, 0(s0)
    addi s0, s0, 4
    addi s1, s1, 1

    j    loop_input

end_input:
    li   a0, 10
    li   a7, 11
    ecall

    la   t2, str_count
    jal  ra, print_str

    li   a7, 1
    mv   a0, s1
    ecall

    li   a0, 10
    li   a7, 11
    ecall

    la   t2, str_array
    jal  ra, print_str

    la   s0, array
    li   t1, 0

loop_print:
    beq  t1, s1, end_print

    lw   a0, 0(s0)
    li   a7, 1
    ecall

    li   a0, 32
    li   a7, 11
    ecall

    addi s0, s0, 4
    addi t1, t1, 1

    j    loop_print

end_print:
    li   a0, 10
    li   a7, 11
    ecall

    li   a7, 10
    ecall

print_str:
    lb   a0, 0(t2)
    beq  a0, zero, pr_ret
    li   a7, 11
    ecall
    addi t2, t2, 1
    j    print_str
pr_ret:
    jr   ra