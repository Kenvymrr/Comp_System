.data
prompt: .string "Vvedite x: "
space:  .string " "
.eqv GROUP_NUM 126
.eqv STUDENT_NUM 22

.text
.globl main
main:
    li a7, 4
    la a0, prompt
    ecall

    li a7, 5
    ecall
    mv t0, a0

    li t1, GROUP_NUM 
    li t2, STUDENT_NUM 

    blt t0, t1, x_is_min
    mv t3, t1          
    mv t4, t0          
    j loop_start

x_is_min:
    mv t3, t0 
    mv t4, t1 

loop_start:
    mv a0, t3
    li a7, 1
    ecall

    li a7, 11
    li a0, 32
    ecall

    add t3, t3, t2

    ble t3, t4, loop_start

    li a7, 10
    ecall